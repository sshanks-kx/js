{
  "name": "kdb-js",
  "version": "0.1.0",
  "description": "Serialize and deserialize kdb+ IPC messages in JavaScript",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./c.js",
  "exports": "./c.js",
  "files": [
    "c.js"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node --check c.js",
    "prepack": "npm run build",
    "test": "node --test",
    "test:coverage": "c8 node --test"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  },
  "c8": {
    "all": true,
    "include": ["c.js"],
    "reporter": ["text", "lcov"]
  }
}
